---
layout: default
---
<div class="post">
  <header class="post-header">
    <p class="post-meta"><a href="{{ "/tags/" | relative_url }}">태그 전체</a></p>
    <h1 class="post-title">태그: {{ page.tag_name }}</h1>
  </header>

  <article>
    <h2>이 태그가 붙은 프로젝트</h2>
    {%- assign sorted_projects = site.projects | sort: "importance" -%}
    <div class="projects">
      <div class="row row-cols-1 row-cols-md-2">
        {%- for project in sorted_projects -%}
          {%- if page.project_tags contains project.tag -%}
            {%- include projects.liquid -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign related = "" | split: "" -%}
    {%- for post in site.posts -%}
      {%- for t in post.tags -%}
        {%- if page.project_tags contains t -%}{%- assign related = related | push: post -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if related.size > 0 -%}
    <h2>관련 글 ({{ related.size }}편)</h2>
    <ul class="post-list">
      {%- for post in related -%}{%- include post_item.liquid post=post -%}{%- endfor -%}
    </ul>
    {%- endif -%}
  </article>
</div>
