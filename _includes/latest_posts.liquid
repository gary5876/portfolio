<div class="news">
  {% if page.latest_posts != blank %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign latest_posts_limit = page.latest_posts.limit | default: 5 %}
        {% for item in site.posts limit: latest_posts_limit %}
          <tr>
            <th scope="row" style="width: 20%; white-space: nowrap">{{ item.date | date: '%Y년 %-m월 %-d일' }}</th>
            <td>
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% if item.description %}<br><span class="text-muted" style="font-size: 0.9em">{{ item.description }}</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
</div>
